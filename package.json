{
  "name": "haze-ui",
  "version": "0.0.0-development",
  "type": "module",
  "description": "A React UI component library powered by react-use-control and Linaria",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/types/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./form": {
      "types": "./dist/types/form/index.d.ts",
      "import": "./dist/form/index.js",
      "default": "./dist/form/index.js"
    },
    "./tokens": {
      "types": "./dist/types/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./styles.css": "./dist/haze-ui.css",
    "./css/*": "./dist/css/*",
    "./css-manifest.json": "./dist/css-manifest.json",
    "./registry.json": "./dist/registry.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "start": "vite",
    "build": "BUILD_LIB=true vite build && node scripts/split-css.mjs && node scripts/generate-registry.mjs && tsc -p tsconfig.lib.json && tsc-alias -p tsconfig.lib.json",
    "build:demo": "BABEL_ENV=development BUILD_DEMO=true vite build && cp dist/index.html dist/404.html",
    "commit": "lint-staged && git-cz -n",
    "coverage": "vitest run --coverage",
    "lint": "eslint --fix src *.mjs",
    "deploy": "npm run build:demo && gh-pages -d dist",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1 playwright test --config e2e/playwright.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "serve": "vite preview",
    "size": "size-limit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmzy/haze-ui.git"
  },
  "keywords": [
    "react",
    "ui",
    "component",
    "library",
    "haze-ui",
    "headless",
    "accessible",
    "accessibility",
    "ai-components",
    "chat-ui",
    "oklch",
    "linaria",
    "zero-runtime",
    "controlled-components",
    "dark-mode"
  ],
  "author": "wmzy",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.2.4",
    "react-f0rm": "^1.1.1",
    "react-use-control": "^1.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@faker-js/faker": "^10.6.0",
    "@for-fun/event-emitter": "^1.1.0",
    "@linaria/core": "^8.2.0",
    "@native-router/core": "^1.16.1",
    "@native-router/react": "^1.15.0",
    "@playwright/test": "^1.62.1",
    "@size-limit/esbuild": "^13.0.3",
    "@size-limit/file": "^13.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.4.1",
    "@types/ramda": "^0.32.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "@wyw-in-js/babel-preset": "^2.5.1",
    "@wyw-in-js/vite": "^2.5.1",
    "babel-plugin-transform-jsx-class": "^0.1.3",
    "babel-plugin-transform-jsx-condition": "^0.1.3",
    "commitizen": "^4.3.2",
    "core-js": "^3.50.0",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-compat": "^7.0.2",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "json-schema-faker": "^0.6.3",
    "lint-staged": "^17.4.1",
    "lucide-react": "^1.41.0",
    "prettier": "^3.9.6",
    "qss": "^3.0.0",
    "ramda": "^0.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-toolroom": "^1.1.0",
    "rollup-plugin-type-as-json-schema": "^0.2.6",
    "semantic-release": "^25.0.9",
    "size-limit": "^13.0.3",
    "terser": "^5.51.2",
    "tools-config": "^0.3.1",
    "tsc-alias": "^1.9.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "size-limit": [
    {
      "name": "Button only (bundled from barrel)",
      "path": "dist/index.js",
      "import": "{Button}",
      "limit": "2 KB"
    },
    {
      "name": "Dashboard profile: Button + Input + Select + Dialog + Toast + Pagination",
      "path": "dist/index.js",
      "import": "{Button, Input, Select, Dialog, Toast, Pagination}",
      "limit": "10 KB"
    },
    {
      "path": "dist/haze-ui.css",
      "limit": "136 KB"
    },
    {
      "path": "dist/haze-ui.css",
      "limit": "19 KB",
      "gzip": true
    }
  ]
}
