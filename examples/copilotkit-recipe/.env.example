# Read by the CopilotKit runtime server (server.ts) at runtime only —
# `pnpm build` and `vite build` never need it. Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: any model string your key can access (server.ts default:
# openai:gpt-5.4-mini)
# COPILOT_MODEL=openai:gpt-5.4-mini

# Optional: where the Vite app finds the runtime server. Defaults to
# http://localhost:8200/api/copilotkit — only set this when the runtime
# runs elsewhere (e.g. a deployed URL in production).
# VITE_COPILOT_RUNTIME_URL=http://localhost:8200/api/copilotkit
